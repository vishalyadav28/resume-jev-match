# Required: get a key from typesafe.ai's waitlist, or use no-wait access via
# the Vercel AI Gateway (see README for the gateway-specific settings).
TYPESAFE_API_KEY=

# Optional: point at a gateway (e.g. Vercel AI Gateway) instead of
# api.typesafe.ai directly.
# TYPESAFE_BASE_URL=

# Optional: minimum confidence (0-1) below which a match response is flagged
# needs_human_review. Defaults to 0.5.
# CONFIDENCE_GATE_THRESHOLD=0.5
